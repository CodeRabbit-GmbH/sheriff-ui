{
  "name": "@softarc/sheriff",
  "version": "0.0.1",
  "description": "Modularity for TypeScript Projects",
  "license": "MIT",
  "scripts": {
    "build:all": "npx nx run-many --target=build && chmod +x dist/packages/core/src/bin/main.js",
    "commit": "commit",
    "generate:api": "ng-openapi-gen -c ng-openapi-gen.json",
    "lint:all": "eslint ./packages",
    "link:sheriff": "yarn run build:all && yalc publish dist/packages/core && yalc publish dist/packages/eslint-plugin && yalc link @softarc/sheriff-core @softarc/eslint-plugin-sheriff",
    "run:cli": "nx build core && chmod +x dist/packages/core/src/bin/main.js",
    "test": "vitest",
    "test:ci": "vitest -c vitest.config.ci.ts",
    "vscode:build": "nx build sheriff-ui --configuration=production && nx build sheriff-api && nx bundle sheriff-vscode",
    "vscode:package": "yarn vscode:build && nx package sheriff-vscode",
    "vscode:publish": "yarn vscode:package && cd dist/packages/sheriff-vscode && npx @vscode/vsce publish"
  },
  "author": {
    "name": "Rainer Hahnekamp",
    "email": "rainer.hahnekamp@gmail.com"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.11",
    "tslib": "^2.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^20.0.0",
    "@angular-devkit/schematics": "^20.0.0",
    "@angular/build": "~20.2.0",
    "@angular/cli": "^20.0.0",
    "@angular/common": "20.3.9",
    "@angular/compiler": "20.3.9",
    "@angular/compiler-cli": "20.3.9",
    "@angular/core": "20.3.9",
    "@angular/platform-browser": "20.3.9",
    "@angular/router": "20.3.9",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@commitlint/prompt-cli": "^19.3.1",
    "@ngrx/signals": "^20.0.0",
    "@nx/esbuild": "21.6.9",
    "@nx/js": "21.6.9",
    "@nx/workspace": "21.6.9",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/eslint": "^8.4.6",
    "@types/estree": "^1.0.0",
    "@types/node": "18.19.14",
    "@types/vscode": "^1.85.0",
    "@uiw/codemirror-theme-vscode": "^4.25.4",
    "@vitest/coverage-v8": "^2.0.3",
    "@vscode/vsce": "^3.2.2",
    "d3-hierarchy": "^3.1.2",
    "daisyui": "^5.1.23",
    "esbuild": "^0.24.2",
    "eslint": "^9.6.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-unused-imports": "^4.0.0",
    "husky": "^9.0.11",
    "konva": "^10.1.0",
    "ng-openapi-gen": "^1.0.5",
    "ng2-konva": "^11.0.0",
    "nx": "21.6.9",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.2.5",
    "rxjs": "^7.8.1",
    "tailwindcss": "^4.1.18",
    "ts-node": "10.9.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.0.3"
  }
}
